---
import { projects } from "../data/content";

interface Props {
  titleLevel?: 2 | 3;
}

const { titleLevel = 3 } = Astro.props;
---

<div class="card-grid">
  {
    projects.map((project) => (
      <a class="card" href={`/projects/${project.slug}`}>
        <p class="card-kicker">
          <span>Sheet {project.sheet}</span>
          <span>{project.featured ? "Featured" : "Project"}</span>
        </p>
        {titleLevel === 2 ? <h2>{project.title}</h2> : <h3>{project.title}</h3>}
        <p class="card-role">
          {project.role}
          {project.organization ? ` · ${project.organization}` : ""}
        </p>
        {project.dates && <p class="meta">{project.dates}</p>}
        <p class="card-summary">{project.summary}</p>
        <p class="card-cta">View project</p>
      </a>
    ))
  }
</div>
