---
import { getProjects } from "../lib/site";

interface Props {
  titleLevel?: 2 | 3;
}

const { titleLevel = 3 } = Astro.props;
const projects = await getProjects();
---

<div class="card-grid">
  {
    projects.map((project) => (
      <a class="card" href={`/projects/${project.id}`}>
        <p class="card-kicker">
          <span>{project.data.featured ? "Featured" : "Project"}</span>
        </p>
        {titleLevel === 2 ? <h2>{project.data.title}</h2> : <h3>{project.data.title}</h3>}
        <p class="card-role">
          {project.data.role}
          {project.data.organization ? ` · ${project.data.organization}` : ""}
        </p>
        {project.data.dates && <p class="meta">{project.data.dates}</p>}
        <p class="card-summary">{project.data.summary}</p>
        <p class="card-cta">View project</p>
      </a>
    ))
  }
</div>
