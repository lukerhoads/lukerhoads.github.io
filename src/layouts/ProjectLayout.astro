---
import Layout from "./Layout.astro";
import type { CollectionEntry, MarkdownHeading } from "astro:content";
import { projectImages } from "../lib/project-images";

interface Props {
  project: CollectionEntry<"projects">;
  headings: MarkdownHeading[];
}

const { project, headings } = Astro.props;
const { title, summary, role, organization, tools, mediaNote, media } = project.data;
const images = projectImages(project.id, media);
const prose = headings.filter((heading) => heading.depth === 2);
const mediaIndex = String(prose.length + 1).padStart(2, "0");

const facts = [
  ["Role", role],
  ["Organization", organization],
  ["Location", project.data.location],
  ["Dates", project.data.dates],
].filter((entry): entry is [string, string] => Boolean(entry[1]));

const description = `${title}. ${role}${organization ? `, ${organization}` : ""}. ${summary}`;
---

<Layout title={`${title} · Luke Rhoads`} description={description}>
  <article class="project">
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <a href="/">Home</a>
      <span aria-hidden="true">/</span>
      <a href="/projects">Projects</a>
      <span aria-hidden="true">/</span>
      <span aria-current="page">{title}</span>
    </nav>

    <header class="title-block">
      <div class="title-grid">
        <div>
          <h1>{title}</h1>
          <p class="lede">{summary}</p>
          {
            tools.length > 0 && (
              <p class="tool-line">Scope: {tools.join(" · ")}</p>
            )
          }
        </div>
        <dl class="spec-list">
          {
            facts.map(([label, value]) => (
              <>
                <dt>{label}</dt>
                <dd>{value}</dd>
              </>
            ))
          }
        </dl>
      </div>
    </header>

    <div class="project-layout">
      <nav class="toc" aria-label="On this page">
        {prose.map((heading) => <a href={`#${heading.slug}`}>{heading.text}</a>)}
        <a href="#media">Media</a>
      </nav>

      <div>
        <div class="project-body">
          <slot />
        </div>

        <section class="block" id="media" aria-labelledby="media-heading">
          <h2 id="media-heading"><span>{mediaIndex}</span>Media</h2>
          {mediaNote && <p class="media-note">{mediaNote}</p>}
          <div class="media-grid">
            {
              images.map((slot) => (
                <figure>
                  {
                    slot.src ? (
                      <img src={slot.src} alt={slot.alt} />
                    ) : (
                      <div class="placeholder" aria-hidden="true">
                        <span>{slot.kind} placeholder</span>
                      </div>
                    )
                  }
                  <figcaption>
                    <strong>{slot.kind}.</strong> {slot.caption}
                  </figcaption>
                </figure>
              ))
            }
          </div>
        </section>
      </div>
    </div>
  </article>
</Layout>
