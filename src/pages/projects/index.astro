---
import Layout from "../../layouts/Layout.astro";
import ProjectGrid from "../../components/ProjectGrid.astro";
import { getHome, getProjects } from "../../lib/site";

const home = await getHome();
const projects = await getProjects();
const countWords = [
  "Zero",
  "One",
  "Two",
  "Three",
  "Four",
  "Five",
  "Six",
  "Seven",
  "Eight",
  "Nine",
  "Ten",
];
const countLabel =
  projects.length <= 10 ? `${countWords[projects.length]} projects` : `${projects.length} projects`;
---

<Layout title="Projects · Luke Rhoads" description={home.data.projectsDescription}>
  <header class="page-intro">
    <p class="kicker">
      <span>{countLabel}</span>
    </p>
    <h1>Projects</h1>
    <p>{home.data.projectsIntro}</p>
  </header>
  <ProjectGrid titleLevel={2} />
</Layout>
