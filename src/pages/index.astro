---
import { render } from "astro:content";
import Layout from "../layouts/Layout.astro";
import ProjectGrid from "../components/ProjectGrid.astro";
import { getHome } from "../lib/site";

const home = await getHome();
const { Content } = await render(home);
const site = home.data;
---

<Layout title="Luke Rhoads · Engineering Portfolio" description={site.description}>
  <header class="hero">
    <p class="kicker">
      <span>Engineering Portfolio</span>
    </p>
    <div class="hero-grid">
      <div class="hero-main">
        <figure class="hero-photo">
          {
            site.portrait ? (
              <img src={site.portrait} alt={`Portrait of ${site.name}`} />
            ) : (
              <div class="placeholder hero-placeholder" aria-hidden="true">
                <span>Photo</span>
              </div>
            )
          }
        </figure>
        <div>
          <h1>{site.name}</h1>
          <div class="hero-copy">
            <Content />
          </div>
        </div>
      </div>
      <aside class="titleblock" aria-labelledby="education-heading">
        <h2 id="education-heading" class="visually-hidden">Education</h2>
        <p class="titleblock-label">Education</p>
        <p class="titleblock-org">{site.school}</p>
        <p class="titleblock-deg">{site.degree}</p>
        <dl class="spec-list">
          <dt>Graduation</dt>
          <dd>{site.graduation}</dd>
          <dt>Location</dt>
          <dd>{site.location}</dd>
          <dt>Email</dt>
          <dd><a href={`mailto:${site.email}`}>{site.email}</a></dd>
        </dl>
      </aside>
    </div>
  </header>

  <section class="section skills" aria-labelledby="skills-heading">
    <div class="section-heading">
      <span class="section-index">01</span>
      <h2 id="skills-heading">Skills</h2>
    </div>
    <ul class="tool-list">
      {site.skills.map((tool) => <li>{tool}</li>)}
    </ul>
  </section>

  <section class="section" aria-labelledby="projects-heading">
    <div class="section-heading">
      <span class="section-index">02</span>
      <h2 id="projects-heading">Projects</h2>
    </div>
    <ProjectGrid titleLevel={3} />
  </section>
</Layout>

<style>
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .titleblock .spec-list {
    border: 0;
    background: transparent;
    padding: 0 0 0.55rem;
  }
</style>
